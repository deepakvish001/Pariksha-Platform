# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it.

# --- Required: Supabase project credentials (read by Vite at build time) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Optional: canonical/OG URLs in src/pages/blog and the sitemap script ---
# Falls back to a built-in default when unset.
# SITE_URL=https://your-domain.example

# --- Optional: feature flag read by src/data/positionResourcesData.ts ---
# Any value other than the literal string "true" leaves the flag off.
# FEATURE_NEW_CHECKOUT=false

# --- Optional: scripts/e2e-assessment-test.mjs only ---
# The script exits with a clear message if these are missing, so leave them
# unset unless you are running that end-to-end check locally.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-publishable-key
# TEST_EMAIL=e2e-user@example.com
# TEST_PASSWORD=your-e2e-user-password
# DRAFT_ASSESSMENT_ID=00000000-0000-0000-0000-000000000000
